{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "orchestrator",
    "agents": {
        "plan": { "disabled": true },
        "title": {
            "model": "container-config/{env:AI_CHEAP_MODEL}"
        }
    },
    "model": "{env:OPENCODE_AI_MODEL}",
    "plugins": [
        "opencode-models-discovery"
    ],
    "providers": {
        "container-config": {
            "package": "@opencode/ai/providers/openai-compatible",
            "name": "container-config",
            "settings": {
                "apiKey": "{env:AI_API_KEY}",
                "baseURL": "{env:AI_API_URL}",
                "chunkTimeout": false,
                "headerTimeout": false,
                "modelsDiscovery": {
                    "enabled": true,
                    "modelInfoFormat": "litellm"
                },
                "timeout": {env:AI_REQUEST_TIMEOUT}000
            }
        }
    }
}
